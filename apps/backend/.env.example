NODE_ENV=development
PORT=4000

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://127.0.0.1:5500,http://127.0.0.1:5501,http://127.0.0.1:5502,http://localhost:5500,http://localhost:5501,http://localhost:5502,http://10.165.17.137:5500,http://10.165.17.137:5501,http://10.165.17.137:5502
FRONTEND_URL=http://127.0.0.1:5500

# SMTP (Brevo example). Use the Brevo SMTP login and SMTP key, not the API key.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_PASS is accepted as a legacy alias; if both are set, keep values identical.
# SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_NAME=IDMC Admissions
SMTP_FROM_EMAIL=verified-sender@example.com

PAYMENT_PROVIDER_CALLBACK_SECRET=replace-with-a-random-secret-of-at-least-24-characters

# Optional authorised national examination-results provider.
# Leave blank to use institutional manual verification.
NATIONAL_RESULTS_PROVIDER_URL=
NATIONAL_RESULTS_PROVIDER_API_KEY=
