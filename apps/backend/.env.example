NODE_ENV=development
PORT=4000

# Local PostgREST during development. For internet deployment, use the Cloudflare
# Tunnel HTTPS origin here, and use the same JWT signing secret as PostgREST.
AUTH_PROVIDER=postgres
POSTGREST_URL=http://127.0.0.1:3001
POSTGREST_SERVICE_ROLE_KEY=replace-with-service-role-jwt
LOCAL_AUTH_JWT_SECRET=replace-with-the-same-long-postgrest-jwt-secret
DATABASE_URL=
# Public Worker API URL, including /api/v1, for private PostgreSQL file links.
PUBLIC_API_URL=http://127.0.0.1:4000/api/v1

# Supabase values are only needed if AUTH_PROVIDER=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional origin for parsing old file URLs in metadata. It is not contacted.
LEGACY_STORAGE_ORIGIN=

# Google Applicant Sign-In uses the existing PostgreSQL Auth provider.
# Configure the OAuth client in Google Cloud and keep its secret only here
# (or in the production secret store). The callback must exactly match the
# Google OAuth web-client redirect URI; in production use the public HTTPS API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/api/v1/auth/google/applicant/callback

JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://127.0.0.1:5500,http://127.0.0.1:5501,http://127.0.0.1:5502,http://localhost:5500,http://localhost:5501,http://localhost:5502,http://10.165.17.137:5500,http://10.165.17.137:5501,http://10.165.17.137:5502
FRONTEND_URL=http://127.0.0.1:5500

# SMTP (Brevo example). Use the Brevo SMTP login and SMTP key, not the API key.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_PASS is accepted as a legacy alias; if both are set, keep values identical.
# SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_NAME=IDMC Admissions
SMTP_FROM_EMAIL=verified-sender@example.com

PAYMENT_PROVIDER_CALLBACK_SECRET=replace-with-a-random-secret-of-at-least-24-characters

# Optional authorised national examination-results provider.
# Leave blank to use institutional manual verification.
NATIONAL_RESULTS_PROVIDER_URL=
NATIONAL_RESULTS_PROVIDER_API_KEY=
