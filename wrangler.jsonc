{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idms-imis-worker",
  "main": "apps/backend/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "enable_nodejs_http_server_modules"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./apps/frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8787",
    "CORS_ORIGIN": "https://idms-imis.pages.dev,https://idms-imis-worker.dcf-org.workers.dev",
    "FRONTEND_URL": "https://idms-imis-worker.dcf-org.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
